#. TRANSLATORS: Names the group the actions below belong to. Plasma reads the
#. actions and never shows this, so it needs no imperative form.
#: usr/share/render-menu-options/render-menu-options.desktop.in:11
msgid "Rendering options"
msgstr "Opcje renderowania"

#. TRANSLATORS: Item in an application's context menu in the application menu.
#. Runs the application on the CPU instead of on any graphics processor.
#: usr/share/render-menu-options/render-menu-options.desktop.in:20
msgid "Software rendering"
msgstr "Renderowanie programowe"

#. TRANSLATORS: Item in an application's context menu. Runs the application on
#. the graphics processor that already drives the display.
#: usr/share/render-menu-options/render-menu-options.desktop.in:27
msgid "Run with the default GPU"
msgstr "Uruchom z domyślnym GPU"

#. TRANSLATORS: Item in an application's context menu. Runs the application on
#. a separate, dedicated graphics card rather than the default one.
#: usr/share/render-menu-options/render-menu-options.desktop.in:37
msgid "Run with the dedicated GPU"
msgstr "Uruchom z dedykowanym GPU"

#. TRANSLATORS: Item in an application's context menu. Runs the application on
#. the graphics processor built into the CPU or chipset.
#: usr/share/render-menu-options/render-menu-options.desktop.in:44
msgid "Run with the integrated GPU"
msgstr "Uruchom ze zintegrowanym GPU"
